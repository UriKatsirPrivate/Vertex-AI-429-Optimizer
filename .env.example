# GOOGLE_CLOUD_PROJECT: The GCP project ID used for Vertex AI calls.
# The backend authenticates via Application Default Credentials (no API key):
# run `gcloud auth application-default login` locally, or attach a service
# account with the Vertex AI User role when deploying (e.g. to Cloud Run).
GOOGLE_CLOUD_PROJECT="my-gcp-project"

# GOOGLE_CLOUD_LOCATION: The Vertex AI location/region for model calls.
GOOGLE_CLOUD_LOCATION="global"

# PORT: Port the backend API server listens on. The Vite dev server proxies
# /api requests to this port. Cloud Run sets this automatically in production.
PORT="8080"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
